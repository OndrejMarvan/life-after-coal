# Supabase (optional). Without these the site runs in demo mode and saves to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI assistant (server side, set in Vercel project settings). Without it the assistant falls back to search.
# Use a key from a Google Cloud project with billing on (required for apps used in the EU).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
